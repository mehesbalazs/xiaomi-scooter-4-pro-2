# Copy to signing.env (git-ignored), fill in your values, then run ./generate.sh.

# Your Apple Developer Team ID: Xcode → Settings → Accounts → your team,
# or developer.apple.com → Membership. A free Apple ID works.
DEVELOPMENT_TEAM=ABCDE12345

# A unique bundle ID prefix. Resulting IDs: <prefix>.app (app), <prefix>.app.widgets
# (widget extension), group.<prefix>.app (App Group).
BUNDLE_ID_PREFIX=com.example.scooterlink
