# Copy to secrets/scooter.env (git-ignored), or let `tokens/get_ltmk.py --save` create it.
# See docs/getting-the-key.md.

# Encrypted BLE key from the Xiaomi cloud (64 hex characters). Required.
SCOOTER_PSK_LOCAL=

# Optional fixed BLE address (macOS: CoreBluetooth UUID, Linux: MAC address).
# Leave empty to find the scooter automatically by its MiBeacon product ID.
SCOOTER_BLE_ADDRESS=
