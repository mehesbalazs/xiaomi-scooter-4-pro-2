# Copy to secrets/scooter.env (git-ignored), or let `tokens/get_ltmk.py --save` create it.
# See docs/getting-the-key.md.

# Encrypted BLE key from the Xiaomi cloud (64 hex characters). Required.
SCOOTER_PSK_LOCAL=

# Your scooter's BLE address (macOS: CoreBluetooth UUID, Linux: MAC address). Leave empty:
# it is filled in automatically after the first successful login (scooter.py --rescan
# searches again).
SCOOTER_BLE_ADDRESS=
